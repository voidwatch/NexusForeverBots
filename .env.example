# Template for .env. install.sh copies it and fills in passwords, REALM_HOST, PATCH_DIR and the bot choices.
# Manual use: cp .env.example .env and edit. Every key is described in docs/CONFIGURATION.md.
# Empty or missing keys fall back to the default shown here (the same default docker-compose.yml uses).

# --- Compose project (only change these to run a second, separate stack on the same machine) ---
# Project name: prefixes containers, volumes (database!) and the network. Default nexusforeverbots.
COMPOSE_PROJECT_NAME=nexusforeverbots
# Prefix of the locally built images (<prefix>-world:local, -auth, -sts). Keep it equal to COMPOSE_PROJECT_NAME.
IMAGE_PREFIX=nexusforeverbots
# Host ports. Clients always connect to the world on 24000 (the realm row uses the container port), so only move these for test stacks.
WORLD_PORT=24000
AUTH_PORT=23115
STS_PORT=6600

# --- Database (alphanumeric only: the passwords go into a connection string unescaped) ---
# Root password, used when the database volume is first created and by the helper scripts.
DB_ROOT_PASSWORD=change-me-root
# Application user, granted on nexus_forever_auth, nexus_forever_character and nexus_forever_world.
DB_USER=nexusforever
# Application user password. Changing it later does not change an existing database (README, Resetting).
DB_PASSWORD=change-me-app

# --- Realm ---
# Address game clients are told to use for the world server: LAN IP or DNS name of THIS host, reachable from the containers too.
REALM_HOST=192.168.1.10
# Realm name shown in the client.
REALM_NAME=NexusForever
# Realm id in the auth database.
REALM_ID=1
# Host address the game ports are published on. 0.0.0.0 = every interface.
BIND_IP=0.0.0.0

# --- Client data ---
# Client Patch folder, mounted read-only by the one-shot tools (mapgen, uiextract). install.sh sets it from --client-dir.
PATCH_DIR=

# --- World server runtime ---
# Minimum milliseconds per world update (20 = at most 50 updates per second).
TICK_MS=20
# Minimum log level: Trace, Debug, Info, Warn, Error. Empty keeps every level (chatty, costs CPU with many bots).
LOG_LEVEL=
# Seconds an idle grid stays loaded.
GRID_UNLOAD_TIMER=300
# Seconds an open-world map with nothing active stays loaded (each loaded world takes 200-500 MB).
MAP_IDLE_UNLOAD=420
# Memory limit of the world container; over it only the world container is killed and restarted.
WORLD_MEM_LIMIT=14g
# 1 turns on the internal timers shown by "gt profile" and "gt maps" (costs a little CPU).
PROFILE=0
# On stop the world saves every online character and waits up to this many seconds (0 = no shutdown save).
SHUTDOWN_SAVE_SECONDS=15

# --- Combat ---
# 1 = damage, healing, death, resurrection and creature respawn. Bots need it to fight and quest.
COMBAT=0
# 1 (needs COMBAT=1) = hostile creatures attack players and bots within 12 m.
COMBAT_AGGRO=0
# 0 turns off charging class resource costs of abilities (Psi Points, Volatility, Actuators, Spell Power).
INNATE_COSTS=1
# Health regeneration out of combat, percent of max health per second (design value, not from the tables).
REGEN_HEALTH_OOC=5
# Health regeneration in combat, percent per second (design value).
REGEN_HEALTH_COMBAT=0
# Suit power regeneration, points per second (design value).
REGEN_SUIT_POWER=5
# Warrior kinetic energy decay in combat, points per second (design value).
DECAY_KINETIC_COMBAT=10
# Warrior kinetic energy decay out of combat, points per second (design value).
DECAY_KINETIC_OOC=100
# Engineer volatility decay out of combat, points per second (design value).
DECAY_VOLATILITY_OOC=10

# --- Bots (change any time with scripts/bots.sh, no rebuild) ---
# Ambient bots kept logged in (0 = none).
BOTS_TARGET=0
# Limit for companion bots added with the console command "bot add".
BOTS_MAX=8
# 1 = bots take no damage (unattended test runs).
BOTS_IMMORTAL=0
# 1 = ambient bots use only fresh clean accounts (bot.clean-N@bots.invalid) for reproducible runs.
BOTS_CLEAN=0
# 1 = bots credit objective types that have no in-world path yet (counted as objective-synthetic). 0 = real objectives only.
BOTS_SYNTHETIC=1
# Comma list of quest objective type ids bots take first (e.g. 12,32). Empty = no preference.
BOTS_FOCUS=
# Multiplier on the damage bots deal (float, e.g. 1.5).
BOTS_DAMAGE=1

# --- Bot teams: dungeons, raids, events, systems, paths ---
# Dungeon/raid/adventure world ids bot teams run in turn (e.g. 382 or 382,1263). 0 or empty = none.
BOTS_DUNGEON=0
# How many bots run dungeons. Empty = all bots when BOTS_DUNGEON is set.
BOTS_DUNGEON_BOTS=
# Dungeon team size.
BOTS_TEAM=5
# Raid world ids for raid teams (e.g. 1333,1462). Empty = none.
BOTS_RAID=
# Raid team size.
BOTS_RAID_TEAM=20
# Number of raid teams.
BOTS_RAID_TEAMS=1
# How teams enter: auto, portal, finder, teleport.
BOTS_DUNGEON_ENTRY=auto
# A team run not cleared after this many minutes is ended (dungeon-timeout).
BOTS_DUNGEON_MINUTES=30
# 1 = raid bosses killed stay dead in later instances of the same owner until the weekly reset.
RAID_SAVED_INSTANCES=1
# Team level: boss, median, quest, or a fixed level 1-50.
BOTS_TEAM_LEVEL=boss
# Veteran variant for team runs: alternate (every second run), all, off.
BOTS_VETERAN=alternate
# Force veteran difficulty for these world ids (comma list) or all. Empty = from the instance entry.
VETERAN_WORLDS=
# 1 = bots travel between public events and fight there instead of questing.
BOTS_EVENTS=0
# How many bots test events. Empty = all (after the dungeon bots) when BOTS_EVENTS=1.
BOTS_EVENT_BOTS=
# Bots (after dungeon and event bots) that run system probes (scripts/system-counts.sh).
BOTS_SYSTEM_BOTS=0
# Quest bots (after the system bots) that play path missions first.
BOTS_PATH_BOTS=0
# Comma list of path mission kinds for path bots (Kill, Activate, Spell, Scan, Area, Holdout, ...). Empty = all.
BOTS_PATH_FOCUS=
